{
  "name": "@clapova/fly",
  "version": "0.1.0",
  "private": true,
  "description": "Clapova distributed rendering on Fly Machines: segment split, R2/S3 storage, assembly, resume after failure.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hyperframes/producer": "workspace:^",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0"
  },
  "engines": {
    "node": ">=22"
  },
  "hyperframesWorkspaceContract": {
    "build": {
      "optOut": true,
      "reason": "Exports pointent vers src/*.ts : le worker Fly exécute les sources TypeScript directement, aucun artefact publié."
    }
  }
}
